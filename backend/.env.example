PORT=3000
NODE_ENV=development

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_NAME=nombre_de_la_bd
# true si el proveedor de MySQL exige SSL (Aiven, TiDB Cloud, etc.)
DB_SSL=false

# Autenticación (JWT). Generá un valor largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS, separados por coma (vacío = cualquiera). Ej: https://gymroutines.vercel.app
CORS_ORIGIN=http://localhost:5173

# IA (opcional)
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3.6-flash